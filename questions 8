------ Questions ---------
---- 1. Students with SGPA > 8
select * 
from Student
where sgpa >8;


----- 2 Customers from Mumbai---
select *
 from Customers 
 where city="Mumbai";
 
 ------ 3 . Orders after Feb 2024---
 SELECT * 
FROM Orders 
WHERE order_date > '2024-02-01';

----- 4 Count employees in each department ---
SELECT dept_id, COUNT(*) AS total
FROM Employees
GROUP BY dept_id;

----- 5Average salary per department--
SELECT dept_id, AVG(salary) AS avg_salary
FROM Employees
GROUP BY dept_id;



--- 6. Customers with total spending---
SELECT customer_id, SUM(amount) AS total_spent
FROM Orders
GROUP BY customer_id;


----- 7. Students with maximum SGPA ---
SELECT *
FROM Student
WHERE sgpa = (SELECT MAX(sgpa) FROM Student);

--- 8 Customer who spent the most---
SELECT customer_id
FROM Orders
GROUP BY customer_id
ORDER BY SUM(amount) DESC
LIMIT 1;
